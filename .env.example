# JARVIS — example environment file.
# Copy to `.env` (same folder as main.py) and fill in real values.
# `.env` is gitignored; this example file contains placeholders only.
#
# Resolution order for every key: real environment variable > .env > (legacy)
# config/api_keys.json. The setup overlay writes GOOGLE_API_KEY here for you.

# ── AI keys ────────────────────────────────────────────────────────────────
# Google Gemini (FREE tier) — required: the realtime voice session uses Gemini Live.
GOOGLE_API_KEY=your-google-api-key-here

# NVIDIA NIM — hosted/free endpoints
NVIDIA_API_KEY=
# PAID APIs — optional, only used if you explicitly select them below.
# The project's cost rule is "no paid keys"; leave these empty to stay free.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional bearer token for a local OpenAI-compatible server (LM Studio etc.)
LOCAL_AI_API_KEY=

# ── Text/vision brain selection (voice stays on Gemini Live) ───────────────
# google | local | anthropic (paid) | openai (paid)
JARVIS_AI_PROVIDER=google
# Leave empty for the provider default (google: gemini-flash-latest).
# anthropic / openai / local REQUIRE a model name, e.g. local: qwen3:8b
JARVIS_AI_MODEL=
JARVIS_AI_MODEL_FAST=
# none | low | medium | high  (thinking/reasoning budget where supported)
JARVIS_AI_EFFORT=
# Comma list of providers to try if the primary fails. Empty = no fallback.
# Paid providers are never added here automatically.
JARVIS_AI_FALLBACKS=

# Local model server
JARVIS_LOCAL_BASE_URL=http://localhost:11434
# ollama | openai  (openai = any OpenAI-compatible local server)
JARVIS_LOCAL_API=ollama

# Optional: OpenAI-compatible base URL (e.g. a self-hosted gateway)
OPENAI_BASE_URL=
